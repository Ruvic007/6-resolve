{
  "name": "6ix-energy-ai",
  "private": true,
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && python server.py",
    "frontend:dev": "cd frontend && npm run dev",
    "test": "npm run test:back && npm run test:front",
    "test:back": "cd backend && pytest",
    "test:front": "cd frontend && npm test",
    "test:api": "start http://localhost:8000/docs",
    "test:mock": "powershell -c \"Invoke-RestMethod -Uri 'http://localhost:8000/api/questionnaire/test' -Method POST | ConvertTo-Json\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
